# ==============================================================================
# ORRICA EDGE ATS & BACKEND API - ENVIRONMENT VARIABLES
# ==============================================================================

# Server & Runtime
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/orrica_edge_db?schema=public"

# Authentication & Security
JWT_ACCESS_SECRET="your-jwt-access-secret-min-32-chars"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-min-32-chars"
MFA_ENCRYPTION_KEY="your-32-char-aes-key-here-12345"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN="http://localhost:3000,http://localhost:5173,https://orricaedge.com,https://www.orricaedge.com,https://orrica-edge-frontend-new.vercel.app"

# Email Delivery (Resend)
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="Orrica Edge <noreply@update.orricaedge.com>"
# Backwards compatibility fallbacks
EMAIL_FROM="Orrica Edge <noreply@update.orricaedge.com>"
MAIL_FROM="Orrica Edge <noreply@update.orricaedge.com>"

# Public Website Form Submissions
FORM_RECIPIENT_EMAIL="sudhanshu@orricaedge.com"
FORM_CC_EMAIL=""
RESPONSE_TIME_TEXT="within 4 business hours"

# Cloudflare Turnstile / hCaptcha (Optional spam defense, disabled by default)
TURNSTILE_SECRET_KEY=""
